{
  "projectType": "sdk-library",
  "projectName": "TinyDecide",
  "projectDescription": "An npm library that wraps any decision API (LLM classifier, ML model, etc.) and transparently learns to answer locally in microseconds with statistically certified agreement guarantees.",
  "theme": "luma",
  "primaryColor": "#4F6CF7",
  "lightColor": "#EEF1FE",
  "darkColor": "#1B2370",
